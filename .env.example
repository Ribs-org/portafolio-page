# Copia este archivo a .env.local y llena los valores.
#
#   npm run setup
#
# hace exactamente eso, y además genera AUTH_SECRET y FINGERPRINT_SALT por ti.
#
# En producción estas variables NO viven en un archivo: se cargan en Vercel
# (Project → Settings → Environment Variables) y bajan con `vercel env pull`.


# ─── Las ponen las integraciones, no las escribas a mano ──────────────────────

# Postgres. La inyecta la integración de Neon al conectarla al proyecto.
# Local: cópiala del dashboard de Neon, o usa `vercel env pull .env.local`.
DATABASE_URL=

# Subida de imágenes (avatar y portada). La inyecta el store de Vercel Blob.
# Sin ella la app funciona: solo no puedes subir imágenes desde el panel.
BLOB_READ_WRITE_TOKEN=


# ─── Tus secretos ─────────────────────────────────────────────────────────────

# Contraseña para entrar a /admin. La eliges tú. Es la única puerta al panel,
# así que que sea larga.
ADMIN_PASSWORD=

# Firma la cookie de sesión del panel. Cadena aleatoria, mínimo 32 bytes.
# Si la cambias, todas las sesiones abiertas se cierran.
# Generar:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Sal del hash que identifica visitantes sin cookies ni IPs guardadas.
# Cámbiala y los "visitantes únicos" históricos dejan de cuadrar con los nuevos.
# Elígela una vez y no la toques.
FINGERPRINT_SALT=


# ─── Opcional ─────────────────────────────────────────────────────────────────

# Zona horaria en la que el dashboard agrupa los días y dibuja el mapa de calor.
# Cualquier nombre IANA: Europe/Madrid, America/Mexico_City, America/Bogota…
# Si la omites, se usa America/Santiago.
SITE_TIMEZONE=America/Santiago

# Analítica de posts. Todas opcionales: sin ellas esa red aparece como no conectada.
# YouTube no usa OAuth, solo estas dos.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# Instagram y TikTok sí. Se crean en developers.facebook.com y developers.tiktok.com.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Solo si administras más de una cuenta de Instagram: cuál conectar. Sin ella, conectar
# falla en vez de adivinar, porque adivinar mal archiva el catálogo de la otra cuenta.
INSTAGRAM_IG_USER_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# La inyecta Vercel al declarar el cron. Sin ella el endpoint responde 401 siempre.
CRON_SECRET=
