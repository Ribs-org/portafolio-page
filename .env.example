# Copia este archivo a .env.local y llena los valores.
#
#   npm run setup
#
# hace exactamente eso, y además genera AUTH_SECRET y FINGERPRINT_SALT por ti.
#
# En producción estas variables NO viven en un archivo: se cargan en Vercel
# (Project → Settings → Environment Variables) y bajan con `vercel env pull`.


# ─── Las ponen las integraciones, no las escribas a mano ──────────────────────

# Postgres, desde Supabase: Project Settings → Database → Connection string.
#
# LAS DOS SALEN DEL POOLER (`...pooler.supabase.com`), NO de `db.<ref>.supabase.co`:
# la conexión directa del plan gratis es solo IPv6, y tanto los runners de Vercel como
# los de GitHub Actions son IPv4. Contra la directa fallan sin poder ni resolver el host.

# "Transaction pooler", puerto 6543. La que usa la app: las funciones serverless abren
# muchas conexiones breves y este es el modo que las aguanta. El código la abre con
# `prepare: false` porque en este modo los prepared statements no sobreviven (src/db).
DATABASE_URL=

# "Session pooler", puerto 5432 — mismo host, otro puerto y otro modo.
# La usan las migraciones (`scripts/migrar.ts`) y `pg_dump`: el modo transacción no
# sostiene el lock del migrador ni acepta DDL encadenado.
# Si falta, el migrador cae de vuelta a DATABASE_URL y probablemente falle.
DATABASE_URL_UNPOOLED=

# Almacenamiento de media (avatares, portadas y los videos programados).
# Bucket de Cloudflare R2 — plan gratis de 10 GB con egress $0.
#
# Créalo en dash.cloudflare.com → R2 → Create bucket, nómbralo portafolio-media,
# cuélgale un subdominio propio (Settings → Public access → Connect domain) y emite
# un token de API con permiso de lectura/escritura SOLO sobre ese bucket.
#
# Cárgalas a Vercel desde Bash con printf, NUNCA con un pipe de PowerShell: el pipe
# le antepone un BOM al valor y la firma S3 falla sin decir por qué.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# No compartas este bucket con nada más: un barrido diario borra todo lo que la
# base de datos no referencia, así que cualquier otra cosa que guardes ahí dura
# menos de 24 horas.
R2_BUCKET=
# Sin barra final, p.ej. https://media.tudominio.com
R2_PUBLIC_BASE=


# ─── Tus secretos ─────────────────────────────────────────────────────────────

# Contraseña de la app del teléfono. La eliges tú. El panel web ya no la usa:
# ahí se entra con tu correo.
ADMIN_PASSWORD=

# El correo del primer usuario, el admin. Con él entras al panel en /ingresar.
# Obligatoria.
ADMIN_EMAIL=

# Remitente de los códigos de ingreso, p. ej. "Parrilla <ingreso@tu-parrilla.cl>".
# El dominio tiene que estar verificado en Resend. Sin ella se usa el remitente
# de prueba, que solo entrega a tu propio correo.
INGRESO_FROM=

# Manda los códigos de ingreso, además del aviso de publicación fallida. Se saca
# de resend.com/api-keys; en producción la provisiona la integración de Resend.
# Sin ella nadie puede entrar al panel, salvo en desarrollo, donde el código
# sale por la consola del servidor.
RESEND_API_KEY=

# Firma la cookie de sesión del panel. Cadena aleatoria, mínimo 32 bytes.
# Si la cambias, todas las sesiones abiertas se cierran.
# Generar:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Sal del hash que identifica visitantes sin cookies ni IPs guardadas.
# Cámbiala y los "visitantes únicos" históricos dejan de cuadrar con los nuevos.
# Elígela una vez y no la toques.
FINGERPRINT_SALT=


# ─── Opcional ─────────────────────────────────────────────────────────────────

# Zona horaria en la que el dashboard agrupa los días y dibuja el mapa de calor.
# Cualquier nombre IANA: Europe/Madrid, America/Mexico_City, America/Bogota…
# Si la omites, se usa America/Santiago.
SITE_TIMEZONE=America/Santiago

# Tu dominio, para etiquetar los enlaces del mensaje automático; si falta se usa el de Vercel.
SITE_URL=

# Analítica de posts. Todas opcionales: sin ellas esa red aparece como no conectada.
# YouTube no usa OAuth, solo estas dos.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# Instagram y TikTok sí. Se crean en developers.facebook.com y developers.tiktok.com.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Del sandbox mientras la app no esté aprobada; los de producción después. Ver README.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# La inyecta Vercel al declarar el cron. Sin ella el endpoint responde 401 siempre.
CRON_SECRET=

# 1 solo cuando la integración de Neon crea una rama por preview.
MIGRAR_PREVIEWS=

# Redactar los borradores de respuesta a comentarios. En Vercel puede omitirse si el
# proyecto usa OIDC. Sin ella los comentarios entran a la cola sin borrador.
AI_GATEWAY_API_KEY=
# Opcional: el modelo de la pasarela, con la forma "proveedor/modelo".
COMENTARIOS_MODELO=

# Opcional. Con "1", tras responder un comentario de Instagram o Facebook se le manda un
# privado a quien comentó. Exige pages_messaging con acceso avanzado, que pasa por revisión
# de Meta. Apagada por defecto.
COMENTARIOS_DM=

# Conectar y publicar en X (OAuth 2.0 + PKCE), y refrescar ese token cuando vence.
# Se crean en developer.x.com, en la misma app que ya usa X_BEARER_TOKEN.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Leer los tuits públicos de los creadores del modo Tinder, con autenticación de
# aplicación. Se saca del portal de desarrolladores de X, en la misma app que ya publica.
X_BEARER_TOKEN=
